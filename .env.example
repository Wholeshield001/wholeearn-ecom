# Django Settings
SECRET_KEY=your-secret-key-here-generate-new-one-for-production
DEBUG=False
ALLOWED_HOSTS=shop.wholeshieldwellness.com,www.shop.wholeshieldwellness.com

# CSRF Settings
CSRF_TRUSTED_ORIGINS=https://shop.wholeshieldwellness.com,https://www.shop.wholeshieldwellness.com

# Database
# For SQLite:
DB_ENGINE=sqlite
# For PostgreSQL, set DB_ENGINE=postgres and values below:
# POSTGRES_DB=wholeearn
# POSTGRES_USER=wholeearn
# POSTGRES_PASSWORD=change-me
# POSTGRES_HOST=db
# POSTGRES_PORT=5432
# Optional host mapping for Docker Compose to avoid port collisions between projects:
# POSTGRES_HOST_PORT=5434

# Email Configuration (optional)
# EMAIL_HOST=smtp.gmail.com
# EMAIL_PORT=587
# EMAIL_USE_TLS=True
# EMAIL_HOST_USER=your-email@example.com
# EMAIL_HOST_PASSWORD=your-email-password

# AWS S3 (if using for media/static files)
# AWS_ACCESS_KEY_ID=your-aws-access-key
# AWS_SECRET_ACCESS_KEY=your-aws-secret-key
# AWS_STORAGE_BUCKET_NAME=your-bucket-name
# AWS_S3_REGION_NAME=us-east-1

# Payment Gateway (if applicable)
# STRIPE_PUBLIC_KEY=pk_test_xxxxx
# STRIPE_SECRET_KEY=sk_test_xxxxx
# STRIPE_WEBHOOK_SECRET=whsec_xxxxx

# Payment provider
PAYMENT_PROVIDER=paystack

# Paystack
PAYSTACK_PUBLIC_KEY=
PAYSTACK_SECRET_KEY=

# Monnify
MONNIFY_API_KEY=
MONNIFY_SECRET_KEY=
MONNIFY_CONTRACT_CODE=
MONNIFY_BASE_URL=https://sandbox.monnify.com
MONNIFY_WEBHOOK_SECRET=
MONNIFY_ACCOUNT_LOOKUP_ENDPOINT=/api/v1/disbursements/account/validate
MONNIFY_TRANSFER_ENDPOINT=/api/v2/disbursements/single
MONNIFY_BANKS_ENDPOINT=/api/v1/banks
MONNIFY_SOURCE_ACCOUNT_NUMBER=
