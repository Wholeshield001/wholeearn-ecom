[Unit]
Description=Gunicorn daemon for wholeearn-ecom shop
After=network.target

[Service]
User=your_vps_username
Group=www-data
WorkingDirectory=/srv/shop_app/current
Environment="PATH=/srv/shop_app/venv/bin"
EnvironmentFile=-/srv/shop_app/.env
ExecStart=/srv/shop_app/venv/bin/gunicorn \
    --workers 3 \
    --bind unix:/srv/shop_app/gunicorn.sock \
    --access-logfile /srv/shop_app/logs/access.log \
    --error-logfile /srv/shop_app/logs/error.log \
    --log-level info \
    core.wsgi:application

[Install]
WantedBy=multi-user.target
